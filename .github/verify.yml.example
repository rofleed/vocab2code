# To enable, save this file as .github/workflows/verify.yml in GitHub's web editor.
name: Verify and package
on: [push, pull_request, workflow_dispatch]
permissions:
  contents: read
jobs:
  verify:
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, windows-latest, macos-latest]
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: npm
      - run: npm ci --ignore-scripts
      - run: npm run package
      - run: npm run check:vsix
      - run: npm run check:release -- --attribution
      - uses: actions/upload-artifact@v4
        with:
          name: vocab2code-${{ matrix.os }}
          path: '*.vsix'
          retention-days: 7
